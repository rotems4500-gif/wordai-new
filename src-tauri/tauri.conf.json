{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WordFlow AI",
  "version": "1.1.0",
  "identifier": "com.wordai.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cross-env VITE_NO_HTTPS=1 vite --port 1420 --strictPort",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "WordFlow AI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/rotems4500-gif/wordai-new/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3MUM1QUI4MjdBMjA0QTIKUldTaUJLSW51Rm9jWnd1UVhrZGNpdHViSjRoL0J2aUxTb0J2eU5aYmNTaXZjVDdYVm9wYnJEV1IK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      { "ext": ["docx"], "name": "WordFlow AI Document", "description": "מסמך WordFlow AI", "role": "Editor" },
      { "ext": ["txt"], "name": "WordFlow AI Text", "description": "מסמך טקסט", "role": "Editor" },
      { "ext": ["html", "htm"], "name": "WordFlow AI HTML", "description": "מסמך HTML", "role": "Editor" }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
