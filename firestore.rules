rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /documents/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /courses/{courseId}/materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /synonymContributions/{contributionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.lemma is string
        && request.resource.data.lemma.size() > 0
        && request.resource.data.lemma.size() <= 30
        && request.resource.data.synonym is string
        && request.resource.data.synonym.size() > 0
        && request.resource.data.synonym.size() <= 30;
      // עדכון סטטוס ע"י סוכן האימות (רץ בצד לקוח — אין שרת; מודל אמון: כל משתמש מחובר)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'validatedAt', 'validationNote']);
      allow delete: if false;
    }

    match /synonymsMeta/{docId} {
      allow read, write: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
